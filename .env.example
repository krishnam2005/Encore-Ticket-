# Neon pooled connection string (include ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Frontend console (optional; both are public, never put secrets here) ---
# Empty = same origin, which is what you want when the UI and API are one Next.js app.
NEXT_PUBLIC_API_BASE_URL=
# The API has no "list events" endpoint, so the console is told which events to show.
NEXT_PUBLIC_EVENT_IDS=evt_001,evt_002

# --- Backend options (all optional) ---
# tier-lock (default) | serializable: lock-free holds via SERIALIZABLE transactions + retry
INVENTORY_LOCKING=tier-lock
# Max POST /events/:id/holds per client per minute (0 disables)
HOLDS_RATE_LIMIT_PER_MIN=120
# Enables GET /admin/audit and /admin/metrics (Authorization: Bearer <token>). Unset = routes return 404.
# ADMIN_TOKEN=change-me
